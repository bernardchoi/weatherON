{
  "expo": {
    "name": "WeatherON",
    "slug": "weatheron",
    "scheme": "weatheron",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "../../assets/icon/icon-light-v2-1024.png",
    "userInterfaceStyle": "automatic",
    "androidStatusBar": {
      "backgroundColor": "#071E33",
      "barStyle": "light-content",
      "translucent": false
    },
    "plugins": [
      [
        "expo-navigation-bar",
        {
          "enforceContrast": false,
          "hidden": false,
          "style": "light"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F5F9FC",
          "image": "../../assets/icon/icon-light-v2-512.png",
          "imageWidth": 108,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#071E33",
            "image": "../../assets/icon/icon-dark-512.png"
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "WeatherON uses your photo library so you can add photos of clothes you own to your wardrobe and outfit recommendations.",
          "cameraPermission": "WeatherON uses the camera so you can photograph clothes you own and add them to your wardrobe and outfit recommendations.",
          "microphonePermission": false
        }
      ],
      "./plugins/withWeatheronAndroidDarkIcon",
      "./plugins/withWeatheronAndroidReleaseConfig"
    ],
    "assetBundlePatterns": [
      "../../assets/icon/*",
      "../../assets/outfits/*",
      "../../assets/place-categories/*",
      "../../assets/wordmark/*",
      "../../assets/onboarding/*",
      "../../assets/ui-icons/*",
      "../../assets/auth-providers/*"
    ],
    "ios": {
      "version": "1.0.0",
      "supportsTablet": false,
      "usesAppleSignIn": true,
      "entitlements": { "aps-environment": "development" },
      "bundleIdentifier": "com.weatheron.mobile",
      "icon": {
        "light": "../../assets/icon/icon-light-v2-1024.png",
        "dark": "../../assets/icon/icon-dark-1024.png"
      },
      "infoPlist": {
        "CFBundleDevelopmentRegion": "en",
        "CFBundleLocalizations": ["ko", "en", "ja"],
        "NSLocationWhenInUseUsageDescription": "WeatherON uses your location to provide local weather and recommendations for getting ready to go out.",
        "NSMotionUsageDescription": "WeatherON uses motion data to adapt weather effects and transitions to your device and accessibility settings.",
        "NSCameraUsageDescription": "WeatherON uses the camera so you can photograph clothes you own and add them to your wardrobe and outfit recommendations.",
        "NSPhotoLibraryUsageDescription": "WeatherON uses your photo library so you can add photos of clothes you own to your wardrobe and outfit recommendations.",
        "NSSupportsLiveActivities": true,
        "ITSAppUsesNonExemptEncryption": false
      },
      "buildNumber": "41"
    },
    "android": {
      "package": "com.weatheron.mobile",
      "versionCode": 19,
      "icon": "../../assets/icon/icon-light-v2-1024.png",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "CAMERA",
        "POST_NOTIFICATIONS"
      ],
      "adaptiveIcon": {
        "foregroundImage": "../../assets/icon/android/icon-adaptive-foreground-light-1024.png",
        "backgroundImage": "../../assets/icon/android/icon-adaptive-background-light-1024.png",
        "monochromeImage": "../../assets/icon/icon-mono-1024.png",
        "backgroundColor": "#F8FBFF"
      }
    },
    "web": {
      "favicon": "../../assets/icon/icon-primary-32.png"
    },
    "extra": {
      "ruleVersion": "weatheron-rules-0.1.0",
      "eas": {
        "projectId": "3bf39144-92a4-48a9-8bd8-ae09daf2a817"
      }
    },
    "owner": "weatheron"
  }
}
