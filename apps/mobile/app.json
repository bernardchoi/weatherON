{
  "expo": {
    "name": "WeatherON",
    "slug": "weatheron",
    "scheme": "weatheron",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "../../assets/icon/icon-light-v2-1024.png",
    "userInterfaceStyle": "automatic",
    "androidStatusBar": {
      "backgroundColor": "#071E33",
      "barStyle": "light-content",
      "translucent": false
    },
    "plugins": [
      [
        "expo-navigation-bar",
        {
          "enforceContrast": false,
          "hidden": false,
          "style": "light"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#071E33",
          "image": "../../assets/icon/icon-primary-512.png",
          "imageWidth": 200,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "보유한 옷 사진을 선택해 내 옷장과 코디 추천에 추가하기 위해 사진 보관함을 사용합니다.",
          "cameraPermission": "보유한 옷을 촬영해 내 옷장과 코디 추천에 추가하기 위해 카메라를 사용합니다.",
          "microphonePermission": false
        }
      ],
      "./plugins/withWeatheronAndroidDarkIcon",
      "./plugins/withWeatheronAndroidReleaseConfig"
    ],
    "assetBundlePatterns": [
      "../../assets/icon/*",
      "../../assets/outfits/*",
      "../../assets/place-categories/*",
      "../../assets/wordmark/*",
      "../../assets/onboarding/*",
      "../../assets/ui-icons/*",
      "../../assets/auth-providers/*"
    ],
    "ios": {
      "version": "1.0.0",
      "supportsTablet": false,
      "usesAppleSignIn": true,
      "entitlements": { "aps-environment": "development" },
      "bundleIdentifier": "com.weatheron.mobile",
      "icon": {
        "light": "../../assets/icon/icon-light-v2-1024.png",
        "dark": "../../assets/icon/icon-dark-1024.png"
      },
      "infoPlist": {
        "CFBundleDevelopmentRegion": "ko",
        "NSLocationWhenInUseUsageDescription": "현재 위치 기준 날씨와 외출 준비 추천을 제공하기 위해 위치 권한을 사용합니다.",
        "NSMotionUsageDescription": "날씨 배경 효과와 화면 전환을 기기 움직임 및 접근성 설정에 맞춰 제공하기 위해 동작 정보를 사용합니다.",
        "NSCameraUsageDescription": "보유한 옷을 촬영해 내 옷장과 코디 추천에 추가하기 위해 카메라를 사용합니다.",
        "NSPhotoLibraryUsageDescription": "보유한 옷 사진을 선택해 내 옷장과 코디 추천에 추가하기 위해 사진 보관함을 사용합니다.",
        "NSSupportsLiveActivities": true,
        "ITSAppUsesNonExemptEncryption": false
      },
      "buildNumber": "34"
    },
    "android": {
      "package": "com.weatheron.mobile",
      "versionCode": 16,
      "icon": "../../assets/icon/icon-light-v2-1024.png",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "CAMERA",
        "POST_NOTIFICATIONS"
      ],
      "adaptiveIcon": {
        "foregroundImage": "../../assets/icon/android/icon-adaptive-foreground-light-1024.png",
        "backgroundImage": "../../assets/icon/android/icon-adaptive-background-light-1024.png",
        "monochromeImage": "../../assets/icon/icon-mono-1024.png",
        "backgroundColor": "#F8FBFF"
      }
    },
    "web": {
      "favicon": "../../assets/icon/icon-primary-32.png"
    },
    "extra": {
      "ruleVersion": "weatheron-rules-0.1.0",
      "eas": {
        "projectId": "3bf39144-92a4-48a9-8bd8-ae09daf2a817"
      }
    },
    "owner": "weatheron"
  }
}
