{
  "name": "@weatheron/mobile",
  "version": "1.0.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "start": "expo start --dev-client",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "web": "expo start --web",
    "eas:login": "npx --yes --cache ../../.npm-cache eas-cli login",
    "eas:whoami": "npx --yes --cache ../../.npm-cache eas-cli whoami",
    "eas:init": "npx --yes --cache ../../.npm-cache eas-cli init",
    "build:android:development": "npx --yes --cache ../../.npm-cache eas-cli build --platform android --profile development",
    "build:android:qa": "npx --yes --cache ../../.npm-cache eas-cli build --platform android --profile qa",
    "build:android:qa:no-wait": "npx --yes --cache ../../.npm-cache eas-cli build --platform android --profile qa --no-wait",
    "build:ios:qa": "npx --yes --cache ../../.npm-cache eas-cli build --platform ios --profile qa",
    "build:android:preview": "npx --yes --cache ../../.npm-cache eas-cli build --platform android --profile preview",
    "build:android:preview:no-wait": "npx --yes --cache ../../.npm-cache eas-cli build --platform android --profile preview --no-wait",
    "build:android:production": "npx --yes --cache ../../.npm-cache eas-cli build --platform android --profile production",
    "build:android:production:no-wait": "npx --yes --cache ../../.npm-cache eas-cli build --platform android --profile production --no-wait"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.7",
    "@weatheron/shared": "file:../../packages/shared",
    "expo": "^57.0.8",
    "expo-apple-authentication": "~57.0.1",
    "expo-blur": "~57.0.2",
    "expo-crypto": "~57.0.1",
    "expo-file-system": "~57.0.1",
    "expo-font": "~57.0.1",
    "expo-image-manipulator": "~57.0.14",
    "expo-image-picker": "~57.0.14",
    "expo-location": "~57.0.6",
    "expo-navigation-bar": "~57.0.2",
    "expo-notifications": "^57.0.7",
    "expo-secure-store": "~57.0.1",
    "expo-splash-screen": "~57.0.5",
    "expo-sqlite": "~57.0.1",
    "expo-status-bar": "~57.0.1",
    "expo-web-browser": "^57.0.2",
    "react": "19.2.3",
    "react-native": "0.86.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "typescript": "~6.0.3"
  }
}
