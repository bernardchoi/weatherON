<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/weatheron_widget_root"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@drawable/weatheron_widget_background"
  android:gravity="center_vertical"
  android:orientation="vertical"
  android:padding="16dp">

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <TextView
      android:id="@+id/weatheron_widget_location"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:ellipsize="end"
      android:maxLines="1"
      android:text="성수동"
      android:textColor="@color/weatheron_widget_text"
      android:textSize="15sp"
      android:textStyle="bold" />

    <TextView
      android:id="@+id/weatheron_widget_updated"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:maxLines="1"
      android:text="WeatherON"
      android:textColor="@color/weatheron_widget_subtle"
      android:textSize="10sp"
      android:textStyle="bold" />
  </LinearLayout>

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <TextView
      android:id="@+id/weatheron_widget_temperature"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:fontFamily="sans-serif-medium"
      android:text="23°"
      android:textColor="@color/weatheron_widget_text"
      android:textSize="38sp" />

    <LinearLayout
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_marginStart="14dp"
      android:layout_weight="1"
      android:orientation="vertical">

      <TextView
        android:id="@+id/weatheron_widget_condition"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="맑음"
        android:textColor="@color/weatheron_widget_accent"
        android:textSize="15sp"
        android:textStyle="bold" />

      <TextView
        android:id="@+id/weatheron_widget_detail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="체감 22° · 강수 10%"
        android:textColor="@color/weatheron_widget_subtle"
        android:textSize="12sp" />
    </LinearLayout>
  </LinearLayout>

  <TextView
    android:id="@+id/weatheron_widget_preparation"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:ellipsize="end"
    android:maxLines="1"
    android:text="준비 부담 낮음"
    android:textColor="@color/weatheron_widget_text"
    android:textSize="13sp"
    android:textStyle="bold" />

  <TextView
    android:id="@+id/weatheron_widget_outfit"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="2dp"
    android:ellipsize="end"
    android:maxLines="1"
    android:text="반팔 티셔츠 · 슬랙스 · 운동화"
    android:textColor="@color/weatheron_widget_subtle"
    android:textSize="11sp" />
</LinearLayout>
